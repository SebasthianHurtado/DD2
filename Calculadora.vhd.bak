library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;

entity Calculadora_interfaz is
port(
	clk	 		  : in std_logic;
	nRst 		  : in std_logic;
	tecla		  : in std_logic_vector(3 downto 0);
	pres		  : buffer std_logic_vector(1 downto 0);
	op			  : buffer std_logic_vector(1 downto 0);
	ena			  : buffer std_logic;
	op1           : buffer std_logic_vector(11 downto 0);
    op1_sgn       : buffer std_logic;
    op2           : buffer std_logic_vector(11 downto 0);
    op2_sgn       : buffer std_logic;
    res           : buffer std_logic_vector(23 downto 0);
    res_sgn       : buffer std_logic
     ); 
end entity;

architecture estructural of Calculadora_interfaz is
  type t_estado is (operando1, operando2, resultado);
  signal estado, estado_sig: t_estado;
  signal registro_actual : std_logic_vector(11 downto 0);
  signal signo_actual    : std_logic;
  signal tipo_tecla		 : std_logic_vector(1 downto 0); --00 nada, 01 numero, 10, letra
  signal num_max 		 : std_logic_vector(1 downto 0);
  signal res_bin		 : std_logic_vector(21 downto 0);
  signal num_1_Bin			 : std_logic_vector(10 downto 0);
  signal num_2_Bin			 : std_logic_vector(10 downto 0);
  signal done			 : std_logic;
begin
	

	BCD_a_BIN_1: entity work.BCD_BN_Signo(rtl)
	port map(
       signo_in    => op1_sgn,
       unidades    => op1(3 downto 0),
       decenas     => op1(7 downto 4),
       centenas    => op1(11 downto 8),
       resultado => num_1_Bin
    );

	BCD_a_BIN_2: entity work.BCD_BN_Signo(rtl)
	port map(
       signo_in    => op2_sgn,
       unidades    => op2(3 downto 0),
       decenas     => op2(7 downto 4),
       centenas    => op2(11 downto 8),
       resultado => num_2_Bin
    );

	Operar: entity work.Operaciones(estructural)
	port map( num_1 	=> num_1_Bin,
		  	  num_2 	=> num_2_Bin,
		  	  resultado => res_bin,
			  op => op);
	
	BIN_a_BCD: entity work.Bin_BCD(rtl)
	port map(
     clk	  => clk,
     nRst     => nRst,
     ena	  => ena,
     bin_in   => res_bin,
     bcd_out  => res,
     sign_out => res_sgn,
     done     => done
	);
	



	process_next_est: process(clk, nRSt)
	begin
	if nRst = '0' then
		estado <= operando1;
	elsif clk'event and clk = '1' then
		estado <= estado_sig;
	end if;
	end process;
	process_estado: process(estado, tecla)
	begin
		case estado is
			when operando1 =>
			op1 <= registro_actual;
			op1_sgn <= signo_actual;
			pres <= "00";
			case tecla is
				when X"A" => op <= "01";
						estado_sig <= operando2;
						num_max <= (others => '0');
				when X"D" => op <= "10";
						estado_sig <= operando2;
						num_max <= (others => '0');
				when X"E" => op <= "11";
						estado_sig <= operando2;
						num_max <= (others => '0');
				when others => op <= (others => '0'); 
			end case;
			
			when operando2 =>
			op2 <= registro_actual;
			op2_sgn <= signo_actual;
			pres <= "01";

			if tecla <= X"B" then
			ena <= '1';
			estado_sig <= resultado;
			num_max <= (others => '0');
			end if;

			when resultado =>
			pres <= "10";
			op <= "00";
			op1 <= (others => '0');
			op1_sgn <= '0';
			op2 <= (others => '0');
			op2_sgn <= '0';
			tipo_tecla <= "00";
			if tipo_tecla = 2 then
				estado_sig <= operando1;
				ena <= '0';
			elsif tipo_tecla = 1 then
				estado_sig <= operando1;
				registro_actual(3 downto 0) <= tecla;
				ena <= '0';
			end if;
		end case;
	end process;
	
	
	process_tipo_tecla : process(clk, nRst)
	begin
	if nRst = '0' then
		tipo_tecla <= "00";
	elsif clk'event and clk = '1' then
		if tecla < 10 then
			tipo_tecla <= "01";
		elsif tecla > 9 then
			tipo_tecla <= "10";
		else 
			tipo_tecla <= "00";
		end if;
	end if;
	end process;


	process_registro: process(clk, nRst)
	begin
	if nRst = '0' then
		registro_actual <= (others => '0');
		signo_actual <= '0';
		num_max <= (others => '0');
	elsif clk'event and clk = '1' then
		if tipo_tecla = "01" and num_max < 4 then
			registro_actual(3 downto 0) <= tecla;
			registro_actual(7 downto 4) <= registro_actual(3 downto 0);
			registro_actual(11 downto 8) <= registro_actual(7 downto 4);
			num_max <= num_max + 1;
		end if;
		if tipo_tecla = "10" and tecla = X"C" then
			signo_actual <= not signo_actual;
		end if;
	end if;
	end process;
	

end estructural;
